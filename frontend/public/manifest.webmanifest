{
  "name": "EventGrid — Gestión de Eventos",
  "short_name": "EventGrid",
  "description": "Plataforma de gestión de eventos, control de asistencia, participantes y check-in QR",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0a0707",
  "theme_color": "#0a0707",
  "categories": ["business", "events", "productivity"],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/barcamp-logo-white.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Control de Asistencia",
      "short_name": "Check-in",
      "description": "Escaneo de entradas QR y registro de asistencia",
