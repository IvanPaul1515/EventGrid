    },
    {
      "name": "Participantes",
      "short_name": "Participantes",
      "description": "Directorio de inscritos y fichas",
      "url": "/participants",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    }
  ]
}
