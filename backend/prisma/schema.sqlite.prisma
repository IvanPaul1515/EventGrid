datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         String    @default("OPERATOR") // ADMIN, OPERATOR, VIEWER
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  importBatches         ImportBatch[]
  auditLogs             AuditLog[]
  attendedRegistrations Registration[]  @relation("AttendanceRegistrar")
  grantedCourtesies     Registration[]  @relation("CourtesyGranter")
  receivedPayments      Payment[]       @relation("PaymentReceiver")
  attendanceLogs        AttendanceLog[]
  modifiedRegistrations Registration[]  @relation("RegistrationModifier")
  modifiedParticipants  Participant[]   @relation("ParticipantModifier")
  sentEmails            EmailLog[]      @relation("EmailSender")

  @@map("users")
}

model Event {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  year        Int
  startDate   DateTime
  endDate     DateTime
  venue       String   @default("PUCMM, Santiago de los Caballeros, RD")
  description String?
  maxCapacity Int?
  status      String   @default("PLANNING") // PLANNING, ACTIVE, COMPLETED, ARCHIVED
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings               EventSettings?
  registrations          Registration[]
  ticketTypes            TicketType[]
  paymentMethods         PaymentMethod[]
  salesResponsibles      SalesResponsible[]
  customFieldDefinitions CustomFieldDefinition[]
  importBatches          ImportBatch[]
  emailConfig            EmailConfig?
  emailTemplates         EmailTemplate[]
  emailLogs              EmailLog[]
  tshirtInventories      TshirtInventory[]

  @@index([year])
  @@index([status])
  @@map("events")
}

model EventSettings {
  id                 String   @id @default(uuid())
  eventId            String   @unique
  primaryColor       String   @default("#e11d48")
  secondaryColor     String   @default("#881337")
  accentColor        String   @default("#f43f5e")
  backgroundColor    String   @default("#09090b")
  themeMode          String   @default("dark")
  currencyCode       String   @default("DOP")
  currencySymbol     String   @default("RD$")
  logoUrl            String?
  loginLogoUrl       String?
  faviconUrl         String?
  coverImageUrl      String?
  subtitle           String   @default("Tecnología, Innovación y Comunidad")
  registrationPrefix String   @default("BC-")
  demoModeEnabled    Boolean  @default(false)
  tshirtSizesEnabled Boolean  @default(false)
  tshirtSizes        String?  // JSON string: ["XS","S","M","L","XL","XXL","XXXL"]
  customCss          String?  // JSON string
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_settings")
}

model Participant {
  id              String   @id @default(uuid())
  documentId      String?
  firstName       String
  lastName        String
  fullName        String
  email           String
  phone           String?
  alternatePhone  String?
  institution     String?
  isDemo          Boolean  @default(false)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  updatedByUser User?          @relation("ParticipantModifier", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  registrations Registration[]

  @@index([email])
  @@index([documentId])
  @@index([fullName])
  @@map("participants")
}

model Registration {
  id                   String   @id @default(uuid())
  eventId              String
  participantId        String
  registrationNumber   String
  source               String   @default("MANUAL") // EXCEL_IMPORT, MANUAL, ONSITE_SALE
  importBatchId        String?
  ticketTypeId         String?
  paymentMethodId      String?
  ticketPrice          Float    @default(0.0)
  amountPaid           Float    @default(0.0)
  balanceDue           Float    @default(0.0)
  totalAmount          Float    @default(0.0)
  isVerified           Boolean  @default(false)
  isCourtesy           Boolean  @default(false)
  courtesyAuthorizedBy String?
  courtesyReason       String?
  courtesyDate         DateTime?
  courtesyUserId       String?
  isDemo               Boolean  @default(false)
  salesResponsibleId   String?
  saleTimestamp        DateTime @default(now())
  status               String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  paymentStatus        String   @default("PENDING") // PENDING, PARTIAL, PAID, COURTESY
  attended             Boolean  @default(false)
  attendedAt           DateTime?
  attendedByUserId     String?
  tshirtSize           String?   // Talla de camiseta registrada en check-in
  tshirtSizeUpdatedAt  DateTime?
  tshirtSizeUpdatedByUserId String?
  tshirtDelivered      Boolean   @default(false)
  tshirtDeliveredAt    DateTime?
  tshirtDeliveredByUserId String?
  updatedByUserId      String?
  qrCode               String?   @unique
  qrGeneratedAt        DateTime?
  qrRevokedAt          DateTime?
  customFields         String?  // JSON string
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant      Participant       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  ticketType       TicketType?       @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  paymentMethod    PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  salesResponsible SalesResponsible? @relation(fields: [salesResponsibleId], references: [id], onDelete: SetNull)
  importBatch      ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  attendedByUser   User?             @relation("AttendanceRegistrar", fields: [attendedByUserId], references: [id], onDelete: SetNull)
  courtesyUser     User?             @relation("CourtesyGranter", fields: [courtesyUserId], references: [id], onDelete: SetNull)
  updatedByUser    User?             @relation("RegistrationModifier", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  attendanceLogs   AttendanceLog[]
  payments         Payment[]
  emailLogs        EmailLog[]

  @@unique([eventId, registrationNumber])
  @@unique([eventId, participantId])
  @@index([eventId, status])
  @@index([eventId, paymentStatus])
  @@index([eventId, attended])
  @@index([eventId, ticketTypeId])
  @@index([eventId, isDemo])
  @@map("registrations")
}

model TicketType {
  id               String    @id @default(uuid())
  eventId          String
  name             String
  price            Float     @default(0.0)
  description      String?
  isActive         Boolean   @default(true)
  presaleStartDate DateTime?
  presaleEndDate   DateTime?
  totalCapacity    Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([eventId, name])
  @@map("ticket_types")
}

model PaymentMethod {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  payments      Payment[]

  @@unique([eventId, name])
  @@map("payment_methods")
}

model Payment {
  id               String   @id @default(uuid())
  registrationId   String
  amount           Float    @default(0.0)
  paymentMethodId  String?
  notes            String?
  receivedByUserId String?
  createdAt        DateTime @default(now())

  registration   Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  paymentMethod  PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  receivedByUser User?          @relation("PaymentReceiver", fields: [receivedByUserId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@map("payments")
}

model SalesResponsible {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  email     String?
  role      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([eventId, name])
  @@map("sales_responsibles")
}

model CustomFieldDefinition {
  id        String   @id @default(uuid())
  eventId   String
  key       String
  label     String
  fieldType String   @default("string")
  options   String?  // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
  @@map("custom_field_definitions")
}

model ImportBatch {
  id               String   @id @default(uuid())
  eventId          String
  importedByUserId String
  fileName         String
  fileSize         Int
  totalRows        Int
  validRows        Int
  importedRows     Int
  updatedRows      Int      @default(0)
  skippedRows      Int      @default(0)
  errorRows        Int      @default(0)
  mappingConfig    String   // JSON string
  createdAt        DateTime @default(now())

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  importedByUser User           @relation(fields: [importedByUserId], references: [id], onDelete: Restrict)
  registrations  Registration[]
  errors         ImportError[]

  @@index([eventId])
  @@map("import_batches")
}

model ImportError {
  id            String   @id @default(uuid())
  importBatchId String
  rowNumber     Int
  fieldName     String?
  errorMessage  String
  rawRowData    String?  // JSON string
  createdAt     DateTime @default(now())

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([importBatchId])
  @@map("import_errors")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   String?  // JSON string
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AttendanceLog {
  id             String       @id @default(uuid())
  registrationId String
  userId         String?
  action         String       // "CHECK_IN" | "REVERT"
  reason         String?
  timestamp      DateTime     @default(now())

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([timestamp])
  @@map("attendance_logs")
}

model EmailConfig {
  id           String   @id @default(uuid())
  eventId      String?  @unique
  host         String   @default("smtp.example.com")
  port         Int      @default(587)
  secure       Boolean  @default(false)
  user         String?
  password     String?
  fromEmail    String   @default("notificaciones@eventgrid.com")
  fromName     String   @default("EventGrid Notificaciones")
  replyToEmail String?
  isEnabled    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("email_configs")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  eventId   String?
  code      String   // INSCRIPTION_CONFIRMATION, DIGITAL_TICKET, EVENT_REMINDER, PAYMENT_CONFIRMATION, PENDING_BALANCE, INSCRIPTION_CANCELLED, GENERAL_ANNOUNCEMENT
  name      String
  subject   String
  bodyHtml  String
  bodyText  String?
  variables String?  // JSON string: ["participantName", "eventName", ...]
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, code])
  @@map("email_templates")
}

model EmailLog {
  id             String   @id @default(uuid())
  eventId        String?
  registrationId String?
  recipientEmail String
  recipientName  String?
  templateCode   String?
  subject        String
  status         String   @default("PENDING") // PENDING, SENT, FAILED, SIMULATED
  errorMessage   String?
  sentByUserId   String?
  sentAt         DateTime @default(now())

  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  sentByUser   User?         @relation("EmailSender", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([registrationId])
  @@index([recipientEmail])
  @@index([status])
  @@index([sentAt])
  @@map("email_logs")
}

model TshirtInventory {
  id                String   @id @default(uuid())
  eventId           String
  size              String
  initialQuantity   Int      @default(0)
  deliveredQuantity Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, size])
  @@map("tshirt_inventories")
}
