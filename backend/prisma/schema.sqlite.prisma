datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  scannerOnly Boolean @default(false)

  recordedExternalPayments Payment[] @relation("PaymentRecorder")
  deviceSessions AuthSession[]
  createdIncidents ReceptionIncident[] @relation("IncidentCreator")
  assignedIncidents ReceptionIncident[] @relation("IncidentAssignee")
  sessionVersion Int @default(0)
  passwordResets PasswordReset[]
  id           String    @id @default(uuid())
  email        String    @unique
  accountStatus String @default("ACTIVE")
  staffArea String?
  assignedEventId String?
  passwordHash String
  fullName     String
  role         String    @default("OPERATOR") // ADMIN, OPERATOR, VIEWER
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  courtesyRequests      CourtesyRequest[] @relation("CourtesyRequester")
  courtesyDecisions     CourtesyRequest[] @relation("CourtesyReviewer")
  importBatches         ImportBatch[]
  auditLogs             AuditLog[]
  attendedRegistrations Registration[]  @relation("AttendanceRegistrar")
  grantedCourtesies     Registration[]  @relation("CourtesyGranter")
  receivedPayments      Payment[]       @relation("PaymentReceiver")
  attendanceLogs        AttendanceLog[]
  modifiedRegistrations Registration[]  @relation("RegistrationModifier")
  modifiedParticipants  Participant[]   @relation("ParticipantModifier")
  sentEmails            EmailLog[]      @relation("EmailSender")
  staffTshirtDeliveries StaffTshirtDelivery[]
  emailBatchJobs        EmailBatchJob[]       @relation("EmailBatchCreator")

  @@map("users")
}

model Event {
  financialReviews FinancialReview[]
  refunds RefundRequest[]
  receptionIncidents ReceptionIncident[]
  defaultTicketTypeId String? @unique
  defaultTicketType TicketType? @relation("OfficialTicket", fields: [defaultTicketTypeId], references: [id], onDelete: Restrict)
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  year        Int
  startDate   DateTime
  endDate     DateTime
  venue       String   @default("Sede Principal del Evento")
  description String?
  maxCapacity Int?
  status      String   @default("PLANNING") // PLANNING, ACTIVE, COMPLETED, ARCHIVED
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courtesyRequests       CourtesyRequest[]
  settings               EventSettings?
  registrations          Registration[]
  ticketTypes            TicketType[]
  paymentMethods         PaymentMethod[]
  salesResponsibles      SalesResponsible[]
  customFieldDefinitions CustomFieldDefinition[]
  importBatches          ImportBatch[]
  emailConfig            EmailConfig?
  emailTemplates         EmailTemplate[]
  emailLogs              EmailLog[]
  tshirtInventories      TshirtInventory[]
  staffTshirtDeliveries  StaffTshirtDelivery[]
  registrationSequence   RegistrationSequence?
  emailBatchJobs         EmailBatchJob[]
  scheduleItems          ScheduleItem[]
  scheduleChangeLogs     ScheduleChangeLog[]
  scheduledNotifications ScheduledNotification[]
  sponsors               Sponsor[]

  @@index([year])
  @@index([status])
  @@map("events")
}

model EventSettings {
  paymentDeadlineAt DateTime?
  paymentInstructions String?
  paymentSupportContact String?
  id                 String   @id @default(uuid())
  eventId            String   @unique
  primaryColor       String   @default("#e11d48")
  secondaryColor     String   @default("#881337")
  accentColor        String   @default("#f43f5e")
  backgroundColor    String   @default("#09090b")
  themeMode          String   @default("dark")
  currencyCode       String   @default("DOP")
  currencySymbol     String   @default("RD$")
  logoUrl            String?
  loginLogoUrl       String?
  faviconUrl         String?
  coverImageUrl      String?
  subtitle           String   @default("Tecnología, Innovación y Comunidad")
  registrationPrefix String   @default("EV-")
  schedulePdfUrl     String?
  demoModeEnabled    Boolean  @default(false)
  tshirtSizesEnabled Boolean  @default(false)
  tshirtSizes        String?  // JSON string: ["XS","S","M","L","XL","XXL","XXXL"]
  sponsorCategoryValues String?
  customCss          String?  // JSON string
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_settings")
}

model Participant {
  id              String   @id @default(uuid())
  documentId      String?
  firstName       String
  lastName        String
  fullName        String
  email           String
  phone           String?
  alternatePhone  String?
  institution     String?
  isDemo          Boolean  @default(false)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  updatedByUser User?          @relation("ParticipantModifier", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  registrations Registration[]

  @@index([email])
  @@index([documentId])
  @@index([fullName])
  @@map("participants")
}

model Registration {
  externalPaymentMethod String?
  financialReviews FinancialReview[]
  refunds RefundRequest[]
  organizationRnc String?
  participantCategory String?
  waitlistState String?
  importOriginalData String?
  paymentFullReported String?
  lastExternalSyncAt DateTime?
  cancelledAt DateTime?
  cancelledByUserId String?
  cancellationReason String?
  cancellationType String?
  externalPaymentStatus String?
  externalReference String?
  externalPlatform String?
  buyerName String?
  originLabel String?
  createdByUserId String?
  commercialUserId String?
  @@unique([eventId, externalPlatform, externalReference])

  receptionIncidents ReceptionIncident[]
  courtesyRequests     CourtesyRequest[]
  id                   String   @id @default(uuid())
  eventId              String
  participantId        String
  registrationNumber   String
  source               String   @default("MANUAL") // EXCEL_IMPORT, MANUAL, ONSITE_SALE
  importBatchId        String?
  ticketTypeId         String?
  paymentMethodId      String?
  ticketPrice          Float    @default(0.0)
  amountPaid           Float    @default(0.0)
  balanceDue           Float    @default(0.0)
  totalAmount          Float    @default(0.0)
  isVerified           Boolean  @default(false)
  isCourtesy           Boolean  @default(false)
  courtesyAuthorizedBy String?
  courtesyReason       String?
  courtesyDate         DateTime?
  courtesyUserId       String?
  isDemo               Boolean  @default(false)
  salesResponsibleId   String?
  saleTimestamp        DateTime @default(now())
  status               String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  paymentStatus        String   @default("PENDING") // PENDING, PARTIAL, PAID, COURTESY
  attended             Boolean  @default(false)
  attendedAt           DateTime?
  attendedByUserId     String?
  tshirtSize           String?   // Talla de camiseta registrada en check-in
  tshirtSizeUpdatedAt  DateTime?
  tshirtSizeUpdatedByUserId String?
  tshirtDelivered      Boolean   @default(false)
  tshirtDeliveredAt    DateTime?
  tshirtDeliveredByUserId String?
  updatedByUserId      String?
  qrCode               String?   @unique
  qrGeneratedAt        DateTime?
  qrRevokedAt          DateTime?
  customFields         String?  // JSON string
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant      Participant       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  ticketType       TicketType?       @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  paymentMethod    PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  salesResponsible SalesResponsible? @relation(fields: [salesResponsibleId], references: [id], onDelete: SetNull)
  importBatch      ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  attendedByUser   User?             @relation("AttendanceRegistrar", fields: [attendedByUserId], references: [id], onDelete: SetNull)
  courtesyUser     User?             @relation("CourtesyGranter", fields: [courtesyUserId], references: [id], onDelete: SetNull)
  updatedByUser    User?             @relation("RegistrationModifier", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  attendanceLogs   AttendanceLog[]
  payments         Payment[]
  emailLogs        EmailLog[]
  emailBatchItems  EmailBatchItem[]

  @@unique([eventId, registrationNumber])
  @@unique([eventId, participantId])
  @@index([eventId, status])
  @@index([eventId, paymentStatus])
  @@index([eventId, attended])
  @@index([eventId, ticketTypeId])
  @@index([eventId, isDemo])
  @@map("registrations")
}

model TicketType {
  defaultFor Event? @relation("OfficialTicket")
  id               String    @id @default(uuid())
  eventId          String
  name             String
  price            Float     @default(0.0)
  description      String?
  isActive         Boolean   @default(true)
  presaleStartDate DateTime?
  presaleEndDate   DateTime?
  totalCapacity    Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([eventId, name])
  @@map("ticket_types")
}

model PaymentMethod {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  payments      Payment[]

  @@unique([eventId, name])
  @@map("payment_methods")
}

model Payment {
  recordedByUserId String?
  recordedByUser User? @relation("PaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  externalMethod String?
  refunds RefundRequest[]
  channel String @default("ONSITE")
  idempotencyKey String? @unique
  externalReference String?
  sourceBatchId String?
  id               String   @id @default(uuid())
  registrationId   String
  amount           Float    @default(0.0)
  paymentMethodId  String?
  notes            String?
  receivedByUserId String?
  createdAt        DateTime @default(now())

  registration   Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  paymentMethod  PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  receivedByUser User?          @relation("PaymentReceiver", fields: [receivedByUserId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@map("payments")
}

model SalesResponsible {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  email     String?
  role      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([eventId, name])
  @@map("sales_responsibles")
}

model CustomFieldDefinition {
  id        String   @id @default(uuid())
  eventId   String
  key       String
  label     String
  fieldType String   @default("string")
  options   String?  // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
  @@map("custom_field_definitions")
}

model ImportBatch {
  contentHash String?
  @@unique([eventId, contentHash])
  id               String   @id @default(uuid())
  eventId          String
  importedByUserId String
  fileName         String
  fileSize         Int
  totalRows        Int
  validRows        Int
  importedRows     Int
  updatedRows      Int      @default(0)
  skippedRows      Int      @default(0)
  errorRows        Int      @default(0)
  mappingConfig    String   // JSON string
  createdAt        DateTime @default(now())

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  importedByUser User           @relation(fields: [importedByUserId], references: [id], onDelete: Restrict)
  registrations  Registration[]
  errors         ImportError[]

  @@index([eventId])
  @@map("import_batches")
}

model ImportError {
  id            String   @id @default(uuid())
  importBatchId String
  rowNumber     Int
  fieldName     String?
  errorMessage  String
  rawRowData    String?  // JSON string
  createdAt     DateTime @default(now())

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([importBatchId])
  @@map("import_errors")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   String?  // JSON string
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AttendanceLog {
  id             String       @id @default(uuid())
  registrationId String
  userId         String?
  action         String       // "CHECK_IN" | "REVERT"
  reason         String?
  timestamp      DateTime     @default(now())

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([timestamp])
  @@map("attendance_logs")
}

model EmailConfig {
  id           String   @id @default(uuid())
  eventId      String?  @unique
  host         String   @default("smtp.example.com")
  port         Int      @default(587)
  secure       Boolean  @default(false)
  user         String?
  password     String?
  fromEmail    String   @default("notificaciones@eventgrid.com")
  fromName     String   @default("EventGrid Notificaciones")
  replyToEmail String?
  isEnabled    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("email_configs")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  eventId   String?
  code      String   // INSCRIPTION_CONFIRMATION, DIGITAL_TICKET, EVENT_REMINDER, PAYMENT_CONFIRMATION, PENDING_BALANCE, INSCRIPTION_CANCELLED, GENERAL_ANNOUNCEMENT
  name      String
  subject   String
  bodyHtml  String
  bodyText  String?
  variables String?  // JSON string: ["participantName", "eventName", ...]
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, code])
  @@map("email_templates")
}

model EmailLog {
  dispatchKey String? @unique
  messageId String? @unique
  id             String   @id @default(uuid())
  eventId        String?
  registrationId String?
  recipientEmail String
  recipientName  String?
  templateCode   String?
  subject        String
  status         String   @default("PENDING") // PENDING, SENT, FAILED, SIMULATED
  errorMessage   String?
  batchId        String?
  sentByUserId   String?
  sentAt         DateTime @default(now())

  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  sentByUser   User?         @relation("EmailSender", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([registrationId])
  @@index([recipientEmail])
  @@index([status])
  @@index([batchId])
  @@index([sentAt])
  @@map("email_logs")
}

model TshirtInventory {
  id                     String   @id @default(uuid())
  eventId                String
  size                   String
  initialQuantity        Int      @default(0)
  deliveredQuantity      Int      @default(0)
  staffReservedQuantity  Int      @default(0)
  staffDeliveredQuantity Int      @default(0)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, size])
  @@map("tshirt_inventories")
}

model StaffTshirtDelivery {
  id                String   @id @default(uuid())
  eventId           String
  size              String
  quantity          Int      @default(1)
  recipientName     String?
  notes             String?
  deliveredByUserId String?
  deliveredAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  event           Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deliveredByUser User? @relation(fields: [deliveredByUserId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("staff_tshirt_deliveries")
}

model RegistrationSequence {
  id        String   @id @default(uuid())
  eventId   String   @unique
  current   Int      @default(0)
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("registration_sequences")
}

model LoginAttempt {
  id             String    @id @default(uuid())
  key            String    @unique
  count          Int       @default(1)
  firstAttemptAt DateTime  @default(now())
  blockedUntil   DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([key])
  @@map("login_attempts")
}

model EmailBatchJob {
  id             String    @id @default(uuid())
  eventId        String
  templateCode   String?
  subject        String
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED, SIMULATED
  totalCount     Int       @default(0)
  processedCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  simulatedCount Int       @default(0)
  cancelledCount   Int       @default(0)
  mode             String    @default("REAL") // REAL, SIMULATION
  customSubject    String?
  customBodyHtml   String?
  customMessage    String?
  templateSnapshot String?   // JSON snapshot of template
  bodyHtml         String?
  bodyText         String?
  filterCriteria   String?   // JSON string
  errorMessage   String?
  createdById    String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdByUser User?            @relation("EmailBatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items         EmailBatchItem[]

  @@index([eventId])
  @@index([status])
  @@map("email_batch_jobs")
}

model EmailBatchItem {
  id             String    @id @default(uuid())
  jobId          String
  registrationId String?
  recipientEmail String
  recipientName  String?
  status         String    @default("PENDING") // PENDING, PROCESSING, ACCEPTED_BY_SMTP, FAILED, SIMULATED, CANCELLED
  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  leaseUntil     DateTime?
  idempotencyKey   String?   @unique
  messageId        String?
  renderedSubject  String?
  renderedHtml     String?
  errorMessage     String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  job          EmailBatchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([status])
  @@index([recipientEmail])
  @@index([messageId])
  @@map("email_batch_items")
}

model ScheduleItem {
  id             String   @id @default(uuid())
  eventId        String
  title          String
  speakerName    String?
  speakerBio     String?
  speakerCompany String?
  room           String?
  day            String   @default("Día 1")
  startTime      String
  endTime        String
  category       String?
  status         String   @default("CONFIRMED")
  description    String?
  order          Int      @default(0)
  isKeynote      Boolean  @default(false)
  isDemo         Boolean  @default(false)
  visibility     String   @default("PUBLISHED") // DRAFT, SCHEDULED, PUBLISHED, CANCELLED
  publishAt      DateTime?
  imageUrl       String?
  announcementText String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  changeLogs     ScheduleChangeLog[]

  @@index([eventId])
  @@index([day])
  @@index([status])
  @@map("schedule_items")
}

model ScheduleChangeLog {
  id              String   @id @default(uuid())
  eventId         String
  scheduleItemId  String
  changedByUserId String?
  changeSummary   String
  previousValues  String   // JSON
  newValues       String   // JSON
  notified        Boolean  @default(false)
  notifiedAt      DateTime?
  batchJobId      String?
  deliveryStatus  String?  @default("NONE") // SENT, SIMULATED, SCHEDULED, NONE
  createdAt       DateTime @default(now())

  scheduleItem    ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([scheduleItemId])
  @@map("schedule_change_logs")
}

model ScheduledNotification {
  id              String    @id @default(uuid())
  eventId         String
  title           String
  message         String
  targetGroup     String    @default("ALL")
  templateCode    String    @default("SCHEDULE_CHANGE_ALERT")
  scheduledFor    DateTime
  status          String    @default("SCHEDULED") // SCHEDULED, PROCESSING, SENT, CANCELLED, FAILED
  mode            String    @default("REAL") // REAL vs SIMULATION
  scheduleItemId  String?
  batchJobId      String?
  createdByUserId String?
  executedAt      DateTime?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
  @@index([scheduledFor])
  @@map("scheduled_notifications")
}

model Sponsor {
  id                String           @id @default(uuid())
  eventId           String
  name              String
  type              String           @default("SPONSOR") // SPONSOR, COLLABORATOR
  category          String?          // Platino, Oro, Plata, Bronce, Aliado, etc.
  contactName       String?
  contactPhone      String?
  contactEmail      String?
  logoUrl           String?
  notes             String?
  contributionType  String           @default("MONETARY") // MONETARY, IN_KIND, MIXED
  inKindDescription String?
  committedAmount   Float            @default(0.0)
  receivedAmount    Float            @default(0.0)
  pendingBalance    Float            @default(0.0)
  commitmentDate    DateTime         @default(now())
  status            String           @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, CANCELLED
  isArchived        Boolean          @default(false)
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  event             Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payments          SponsorPayment[]

  @@unique([eventId, name])
  @@index([eventId])
  @@index([type])
  @@index([status])
  @@index([isArchived])
  @@map("sponsors")
}

model SponsorPayment {
  id               String    @id @default(uuid())
  sponsorId        String
  amount           Float
  paymentDate      DateTime  @default(now())
  paymentMethod    String    @default("TRANSFER") // TRANSFER, CHECK, CASH, CREDIT_CARD, OTHER
  reference        String?
  receiptNumber    String?
  notes            String?
  status           String    @default("ACTIVE") // ACTIVE, ANNULLED
  annulledAt       DateTime?
  annulledReason   String?
  annulledByUserId String?
  recordedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sponsor          Sponsor   @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
  @@index([status])
  @@index([paymentDate])
  @@map("sponsor_payments")
}

model StaffMember {
  id String @id @default(uuid())
  eventId String
  firstName String
  lastName String
  email String
  phone String?
  function String?
  area String?
  status String @default("ACTIVE")
  notes String?
  userId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([eventId])
  @@map("staff_members")
}

model UserInvitation {
  id String @id @default(uuid())
  userId String
  tokenHash String? @unique
  expiresAt DateTime?
  usedAt DateTime?
  revokedAt DateTime?
  status String @default("PENDING")
  messageId String?
  errorMessage String?
  createdAt DateTime @default(now())
  sentAt DateTime?
  @@index([userId])
  @@map("user_invitations")
}

model InvitationDispatch {
  id String @id @default(uuid())
  requestKey String @unique
  actorUserId String
  status String @default("PROCESSING")
  results String?
  createdAt DateTime @default(now())
  @@map("invitation_dispatches")
}

// Additive workflow: pending requests never settle a registration or create a payment.
model CourtesyRequest {
  exceptionType String @default("COURTESY")
  agreementReference String?
  id                  String @id @default(uuid())
  eventId             String
  registrationId      String
  requestedByUserId   String
  reason              String
  status              String @default("PENDING")
  requestKey          String
  pendingRegistrationId String? @unique
  decidedByUserId     String?
  decisionReason      String?
  createdAt           DateTime @default(now())
  decidedAt           DateTime?
  event               Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration        Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  requestedBy         User @relation("CourtesyRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy           User? @relation("CourtesyReviewer", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  @@unique([eventId, requestedByUserId, requestKey])
  @@index([eventId, status, createdAt])
  @@map("courtesy_requests")
}

model PasswordReset {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  status String @default("PREPARED")
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  @@index([userId,createdAt])
  @@map("password_resets")
}

model ReceptionIncident {
  id String @id @default(uuid())
  eventId String
  registrationId String?
  participantLabel String
  category String
  description String
  createdByUserId String
  assignedToUserId String?
  status String @default("OPEN")
  resolution String?
  requestKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt DateTime?
  event Event @relation(fields:[eventId],references:[id],onDelete:Restrict)
  registration Registration? @relation(fields:[registrationId],references:[id],onDelete:Restrict)
  createdBy User @relation("IncidentCreator",fields:[createdByUserId],references:[id],onDelete:Restrict)
  assignedTo User? @relation("IncidentAssignee",fields:[assignedToUserId],references:[id],onDelete:Restrict)
  @@unique([eventId,createdByUserId,requestKey])
  @@index([eventId,status,createdAt])
  @@map("reception_incidents")
}

// Device identity is independent from the account-wide revocation version.
model AuthSession {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionVersion Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  @@index([userId, revokedAt])
}

// Relay authority is persisted; SSE is only a targeted invalidation hint.
model ReceptionStation {
  id String @id @default(uuid())
  eventId String
  sessionId String @unique
  userId String
  label String
  leaseUntil DateTime
  busy Boolean @default(false)
  activeLinkId String? @unique
  activeReadingId String? @unique
  version Int @default(0)
  @@index([eventId, userId, leaseUntil])
}
model ScannerLink {
  id String @id @default(uuid())
  eventId String
  stationId String
  mobileSessionId String
  status String @default("REQUESTED")
  codeHash String?
  codeCipher String?
  attempts Int @default(0)
  expiresAt DateTime
  mobileLeaseUntil DateTime
  createdAt DateTime @default(now())
  @@index([mobileSessionId, status])
  @@index([stationId, status])
}
model ScannerReading {
  id String @id @default(uuid())
  linkId String
  stationId String
  requestKey String
  registrationId String?
  status String @default("PENDING")
  result String
  createdAt DateTime @default(now())
  @@unique([linkId, requestKey])
}

model FinancialReview {
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  id String @id @default(uuid())
  eventId String
  registrationId String?
  sourceBatchId String?
  code String
  reason String
  evidence String?
  fingerprint String
  status String @default("OPEN")
  createdByUserId String
  resolvedByUserId String?
  resolution String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@unique([eventId, fingerprint])
  @@index([eventId, status])
}
model RefundRequest {
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  id String @id @default(uuid())
  eventId String
  registrationId String
  paymentId String
  requestKey String
  status String @default("REQUESTED")
  channel String
  amount Float
  approvedAmount Float @default(0)
  refundedAmount Float @default(0)
  reason String
  decisionReason String?
  reference String?
  method String?
  requestedByUserId String
  decidedByUserId String?
  confirmedByUserId String?
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refundedAt DateTime?
  @@unique([eventId, requestKey])
  @@index([eventId, registrationId])
  @@index([paymentId, status])
}

// Collaborative reception is opt-in; QR reads never mark attendance.
model ReceptionQueue {
  id String @id @default(uuid())
  eventId String @unique
  enabled Boolean @default(false)
}
model QueueStation {
  id String @id @default(uuid())
  eventId String
  userId String
  sessionId String @unique
  label String
  mode String @default("DIRECT")
  leaseUntil DateTime
  @@index([eventId, mode, leaseUntil])
}
model QueueDevice {
  id String @id @default(uuid())
  activeSessionId String? @unique
  eventId String
  stationId String
  userId String
  sessionId String
  status String @default("REQUESTED")
  codeHash String?
  codeCipher String?
  attempts Int @default(0)
  expiresAt DateTime
  leaseUntil DateTime
  createdAt DateTime @default(now())
  @@index([stationId, status])
  @@index([sessionId, status])
}
model QueueEntry {
  id String @id @default(uuid())
  eventId String
  registrationId String
  stationId String
  deviceId String?
  state String @default("WAITING")
  firstScannedAt DateTime @default(now())
  lastScannedAt DateTime @default(now())
  claimedBySessionId String?
  claimedByUserId String?
  claimUntil DateTime?
  @@unique([eventId, registrationId])
  @@index([eventId, state, firstScannedAt])
}
