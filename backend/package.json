{
  "name": "eventgrid-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "EventGrid REST API — Servicio backend para administración de eventos, inscripciones, ventas y control de asistencia",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/prisma-detect.js generate && tsc",
    "start": "node scripts/prisma-detect.js db push && npx tsx prisma/seed.ts && node dist/server.js",
    "prisma:generate": "node scripts/prisma-detect.js generate",
    "prisma:migrate": "node scripts/prisma-detect.js migrate dev",
    "prisma:push": "node scripts/prisma-detect.js db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "vitest run --config ../vitest.config.ts --fileParallelism=false",
    "prisma:generate:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "prisma:generate:postgres": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:validate": "node scripts/prisma-detect.js validate",
    "prisma:validate:all": "node scripts/prisma-detect.js validate:all"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.15",
    "nodemailer": "^10.1.7",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.4.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
