# Docker Compose: copy to a PRIVATE .env only if it does not already exist.
# Never overwrite an existing environment or change an existing encryption key.
NODE_ENV=production
API_PREFIX=/api/v1
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=4000
PORT=4000
CORS_ORIGIN=http://localhost:3000
POSTGRES_USER=eventgrid
POSTGRES_DB=eventgrid
# Use random hexadecimal secrets (at least 32 characters), not example passwords.
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
APP_SECRET=
# Native/local Prisma only. Compose constructs its own URL with host postgres.
# URL-encode non-hexadecimal passwords. Do not point this at production.
DATABASE_URL=postgresql://eventgrid:REPLACE_PASSWORD@localhost:5432/eventgrid?schema=public
VITE_API_URL=/api/v1
DOCKER_NAMESPACE=eventgrid-local
IMAGE_VERSION=dev
VCS_REF=unknown
# SMTP settings are encrypted in the persistent database via administration.
# Preserve APP_SECRET alongside database backups. No SMTP credentials in images.
BLOCK_REAL_EMAIL=true
DEMO_QUICK_ACCESS=false
DEMO_SEED=false
# Only used to create the FIRST administrator in an empty production database.
# Subsequent starts never overwrite users/passwords.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador

# Optional private runtime SMTP. Leave empty until the provider supplies every value.
# Bootstrap prepares encrypted settings once, disabled; it never sends or retries mail.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_REPLY_TO=
# true: implicit TLS; false: STARTTLS required. Certificate verification stays enabled.
SMTP_SECURE=
