# ===================================================
# EventGrid — Environment Configuration Template
# Duplicate this file as '.env' and fill in your values
# ===================================================

# Backend Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Security & Authentication (JWT & Cookies)
# IMPORTANT: Generate secure random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_super_secure_cookie_secret_key_here

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://eventgrid_user:your_secure_password@localhost:5432/eventgrid_db?schema=public

# Docker Compose PostgreSQL Configuration
POSTGRES_USER=eventgrid_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=eventgrid_db
POSTGRES_PORT=5432

# Frontend Application Configuration
VITE_API_URL=http://localhost:4000/api/v1
